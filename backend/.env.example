# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Auth
# NOTE: If JWT_SECRET contains '$', escape it as '$$' to prevent GNU Make from corrupting it during exports
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRY_MINUTES=60

# Server
API_HOST=127.0.0.1
API_PORT=8081

# Data directories (relative to backend root)
DATA_DIR=./data
SQLITE_PATH=./data/db.sqlite3
UPLOAD_DIR=./data/uploads

# ChromaDB
CHROMA_DIR=./data/chroma

# FalkorDB
FALKORDB_DIR=./data/falkordb

# Embedding model
EMBEDDING_MODEL=text-embedding-004

# Gemini API Key (Required for embedding generation)
GEMINI_API_KEY=
